    </decisions>
    <description>Record-triggered on Candidate. When a candidate enters status Processing, it reads the CV file with the Extract_CV prompt template and fills the candidate fields. It runs asynchronously in its own transaction, right after the save, never inside the upload screen flow. The years of experience are calculated by Apex (ExperienceYears) from the job dates the AI lists. If a CV cannot be read the first time, it is read again once after 2 minutes (CvReadRetry). After that, unreadable CVs stay Needs Review and errors become Failed.</description>
    <environments>Default</environments>
    <formulas>
        <name>faultText</name>
        <dataType>String</dataType>
        <expression>LEFT(&quot;Could not read this CV: &quot; &amp; {!$Flow.FaultMessage}, 255)</expression>
    </formulas>
    <formulas>
        <name>fCard</name>
        <dataType>String</dataType>
        <expression>LEFT(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE({!Extract_CV.structuredResponse.CandidateCardPT}, &quot;[YEARS]&quot;, {!calcYears.years}), &quot;[YEARS_CALC]&quot;, {!calcYears.calculation}), &quot;[YEARS_CHECK]&quot;, {!calcYears.check}), 32768)</expression>
    </formulas>
    <formulas>
        <name>fEmail</name>
        <dataType>String</dataType>
        <expression>IF(AND(NOT(ISBLANK({!Extract_CV.structuredResponse.EmailPT})), CONTAINS({!Extract_CV.structuredResponse.EmailPT}, &quot;@&quot;)), LEFT(TRIM({!Extract_CV.structuredResponse.EmailPT}), 80), &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>fFirstFailure</name>
        <dataType>Boolean</dataType>
        <expression>AND({!fStatus} = &quot;Needs Review&quot;, NOT(CONTAINS(BLANKVALUE({!$Record.Error_Message_c__c}, &quot;-&quot;), &quot;[auto-retry]&quot;)))</expression>
    </formulas>
    <formulas>
        <name>fLocation</name>
        <dataType>String</dataType>
        <expression>IF(OR(ISBLANK({!Extract_CV.structuredResponse.LocationPT}), UPPER(TRIM({!Extract_CV.structuredResponse.LocationPT})) = &quot;MISSING&quot;), &quot;&quot;, LEFT(TRIM({!Extract_CV.structuredResponse.LocationPT}), 255))</expression>
    </formulas>
    <formulas>
        <name>fName</name>
        <dataType>String</dataType>
        <expression>IF({!fNameMissing}, {!$Record.Name}, LEFT(TRIM({!Extract_CV.structuredResponse.NamePT}), 80))</expression>
    </formulas>
    <formulas>
        <name>fNameMissing</name>
        <dataType>Boolean</dataType>
        <expression>OR(ISBLANK({!Extract_CV.structuredResponse.NamePT}), UPPER(TRIM({!Extract_CV.structuredResponse.NamePT})) = &quot;MISSING&quot;)</expression>
    </formulas>
    <formulas>
        <name>fPhone</name>
        <dataType>String</dataType>
        <expression>IF(OR(ISBLANK({!Extract_CV.structuredResponse.PhonePT}), UPPER(TRIM({!Extract_CV.structuredResponse.PhonePT})) = &quot;MISSING&quot;), &quot;&quot;, LEFT(TRIM({!Extract_CV.structuredResponse.PhonePT}), 40))</expression>
    </formulas>
    <formulas>
        <name>fReviewNote</name>
        <dataType>String</dataType>
        <expression>IF({!fStatus} = &quot;Needs Review&quot;, &quot;The CV could not be read, or it has no usable details. Check the file, then set Extraction Status to Processing to read it again.&quot;, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>fSkills</name>
        <dataType>String</dataType>
        <expression>IF(OR(ISBLANK({!Extract_CV.structuredResponse.SkillsPT}), UPPER(TRIM({!Extract_CV.structuredResponse.SkillsPT})) = &quot;MISSING&quot;), &quot;&quot;, LEFT(TRIM({!Extract_CV.structuredResponse.SkillsPT}), 255))</expression>
    </formulas>
    <formulas>
        <name>fStatus</name>
        <dataType>String</dataType>
        <expression>IF(OR({!fNameMissing}, AND(ISBLANK({!fTitle}), ISBLANK({!fSkills}), ISBLANK({!fLocation}))), &quot;Needs Review&quot;, &quot;Done&quot;)</expression>
    </formulas>
    <formulas>
        <name>fTitle</name>
        <dataType>String</dataType>
        <expression>IF(OR(ISBLANK({!Extract_CV.structuredResponse.CurrentTitlePT}), UPPER(TRIM({!Extract_CV.structuredResponse.CurrentTitlePT})) = &quot;MISSING&quot;), &quot;&quot;, LEFT(TRIM({!Extract_CV.structuredResponse.CurrentTitlePT}), 255))</expression>
    </formulas>
    <formulas>
        <name>fYears</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!calcYears.years}), &quot;0&quot;, {!calcYears.years})</expression>
    </formulas>
    <formulas>
        <name>isSupportedType</name>
        <dataType>Boolean</dataType>
        <expression>OR(LOWER({!cvFile.FileExtension}) = &quot;pdf&quot;, LOWER({!cvFile.FileExtension}) = &quot;doc&quot;, LOWER({!cvFile.FileExtension}) = &quot;docx&quot;)</expression>
    </formulas>
