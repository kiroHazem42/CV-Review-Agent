    <decisions>
        <name>checkFile</name>
        <label>checkFile</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Extract_CV</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>File OK</defaultConnectorLabel>
        <rules>
            <name>noFile</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>cvFile</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>setErrNoFile</targetReference>
            </connector>
            <label>File missing</label>
        </rules>
        <rules>
            <name>badType</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>isSupportedType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>setErrBadType</targetReference>
            </connector>
            <label>Unsupported type</label>
        </rules>
        <rules>
            <name>tooBig</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>cvFile.ContentSize</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>4194304.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>setErrTooBig</targetReference>
            </connector>
            <label>Too big</label>
        </rules>
    </decisions>
