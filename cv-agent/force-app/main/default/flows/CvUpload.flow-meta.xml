<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>set_candidate</name>
        <label>set candidate</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>fileCount</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newCandidate.Name</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>temprorayCandidateName</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newCandidate.Extraction_Status_c__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Processing</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newCandidate.Source_File_Id_c__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>loopDocsToCreateCandidates</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>candidatesToCreate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>newCandidate</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>loopDocsToCreateCandidates</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>setLink</name>
        <label>setLink</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>newLink.LinkedEntityId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>For_Each_Item_in_candidatesToCreate.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newLink.ContentDocumentId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>For_Each_Item_in_candidatesToCreate.Source_File_Id_c__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newLink.ShareType</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>V</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>linksToCreate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>newLink</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>For_Each_Item_in_candidatesToCreate</targetReference>
        </connector>
    </assignments>
    <customProperties>
        <name>ScreenProgressIndicator</name>
        <value>
            <stringValue>{&quot;location&quot;:&quot;top&quot;,&quot;type&quot;:&quot;simple&quot;}</stringValue>
        </value>
    </customProperties>
    <environments>Default</environments>
    <formulas>
        <name>temprorayCandidateName</name>
        <dataType>String</dataType>
        <expression>&quot;Unknown CV &quot; &amp; TEXT({!fileCount})</expression>
    </formulas>
    <interviewLabel>CvUpload {!$Flow.CurrentDateTime}</interviewLabel>
    <label>CvUpload</label>
    <loops>
        <name>For_Each_Item_in_candidatesToCreate</name>
        <label>For Each Item in candidatesToCreate</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>candidatesToCreate</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>setLink</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Create_Links</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>loopDocsToCreateCandidates</name>
        <label>loopDocsToCreateCandidates</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>uploadedDocIds</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>set_candidate</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>createCandidates</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_Links</name>
        <label>Create_Links</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Result</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Error</targetReference>
        </faultConnector>
        <inputReference>linksToCreate</inputReference>
    </recordCreates>
    <recordCreates>
        <name>createCandidates</name>
        <label>createCandidates</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>For_Each_Item_in_candidatesToCreate</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Error</targetReference>
        </faultConnector>
        <inputReference>candidatesToCreate</inputReference>
    </recordCreates>
    <screens>
        <name>Error</name>
        <label>Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Error_Text</name>
            <fieldText>&lt;p&gt;Something went wrong while saving your CVs: {!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Result</name>
        <label>Result</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Result_Text</name>
            <fieldText>&lt;p&gt;{!fileCount} CV(s) received. Reading has started and usually takes less than a minute per CV. A Word file that is not ready yet is read again automatically after about 2 minutes. Open the Candidates tab and refresh it: each CV shows Processing first, then Done, Needs Review or Failed.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Upload</name>
        <label>Upload</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>loopDocsToCreateCandidates</targetReference>
        </connector>
        <fields>
            <name>Upload_display_text</name>
            <fieldText>&lt;p&gt;Upload up to 10 CVs. PDF, DOC or DOCX, 4 MB or less each.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>CV_Upload</name>
            <extensionName>forceContent:fileUpload</extensionName>
            <fieldType>ComponentInstance</fieldType>
            <inputParameters>
                <name>label</name>
                <value>
                    <stringValue>Select CVs</stringValue>
                </value>
            </inputParameters>
            <inputParameters>
                <name>accept</name>
                <value>
                    <stringValue>.pdf,.doc,.docx</stringValue>
                </value>
            </inputParameters>
            <inputParameters>
                <name>multiple</name>
                <value>
                    <booleanValue>true</booleanValue>
                </value>
            </inputParameters>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <outputParameters>
                <assignToReference>uploadedDocIds</assignToReference>
                <name>contentDocIds</name>
            </outputParameters>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Upload</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>candidatesToCreate</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <objectType>Candidate_c__c</objectType>
    </variables>
    <variables>
        <name>fileCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>linksToCreate</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>ContentDocumentLink</objectType>
    </variables>
    <variables>
        <name>newCandidate</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Candidate_c__c</objectType>
    </variables>
    <variables>
        <name>newLink</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>ContentDocumentLink</objectType>
    </variables>
    <variables>
        <name>uploadedDocIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
