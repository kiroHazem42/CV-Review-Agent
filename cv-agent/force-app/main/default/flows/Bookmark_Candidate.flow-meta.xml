    <decisions>
        <name>alreadyBookmarked</name>
        <label>already bookmarked?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>buildBookmark</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>no</defaultConnectorLabel>
        <rules>
            <name>bookmarkExists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>getExisting</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>showAlreadyDone</targetReference>
            </connector>
            <label>yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>messageCheck</name>
        <label>check the lookup message</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>getExisting</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>no message</defaultConnectorLabel>
        <rules>
            <name>hasMessage</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>lookupMessage</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>showLookupMessage</targetReference>
            </connector>
            <label>has a message</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>fContext</name>
        <dataType>String</dataType>
        <expression>LEFT(&quot;Evaluated for &quot; &amp; IF(ISBLANK({!theRole.Name}), &quot;a deleted role&quot;, {!theRole.Name}) &amp; &quot; on &quot; &amp; TEXT(DATEVALUE({!theEval.CreatedDate})) &amp; &quot; (&quot; &amp; TEXT({!theEval.Recommendation__c}) &amp; &quot;)&quot;, 255)</expression>
    </formulas>
    <formulas>
        <name>fMessageError</name>
        <dataType>String</dataType>
        <expression>IF({!fMessageStatus} = &quot;Failed&quot;, {!lookupMessage}, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>fMessageStatus</name>
        <dataType>String</dataType>
        <expression>IF(CONTAINS({!lookupMessage}, &quot;could not be read&quot;), &quot;Failed&quot;, &quot;Needs Input&quot;)</expression>
    </formulas>
    <formulas>
        <name>fRelated</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!bookmarkId}), {!theEval.Id}, {!bookmarkId})</expression>
    </formulas>
