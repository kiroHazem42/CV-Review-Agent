        <faultConnector>
            <targetReference>checkFailed</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Unique_Key__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>theEval.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Candidate_Bookmark__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
