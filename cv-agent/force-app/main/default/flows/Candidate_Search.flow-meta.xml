<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>find_the_candidates</name>
        <label>find the candidates</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>FindCandidates</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>messageCheck</targetReference>
        </connector>
        <flowTransactionModel>Automatic</flowTransactionModel>
        <inputParameters>
            <name>includeCards</name>
            <value>
                <elementReference>includeCards</elementReference>
                <inputConfiguratorMode>Resource</inputConfiguratorMode>
            </value>
        </inputParameters>
        <inputParameters>
            <name>location</name>
            <value>
                <elementReference>location</elementReference>
                <inputConfiguratorMode>Resource</inputConfiguratorMode>
            </value>
        </inputParameters>
        <inputParameters>
            <name>maxResults</name>
            <value>
                <elementReference>maxResults</elementReference>
                <inputConfiguratorMode>Resource</inputConfiguratorMode>
            </value>
        </inputParameters>
        <inputParameters>
            <name>minYears</name>
            <value>
                <elementReference>minYears</elementReference>
                <inputConfiguratorMode>Resource</inputConfiguratorMode>
            </value>
        </inputParameters>
        <inputParameters>
            <name>name</name>
            <value>
                <elementReference>candidateName</elementReference>
                <inputConfiguratorMode>Resource</inputConfiguratorMode>
            </value>
        </inputParameters>
        <inputParameters>
            <name>skill</name>
            <value>
                <elementReference>skill</elementReference>
                <inputConfiguratorMode>Resource</inputConfiguratorMode>
            </value>
        </inputParameters>
        <nameSegment>FindCandidates</nameSegment>
        <offset>0</offset>
        <outputParameters>
            <assignToReference>searchMessage</assignToReference>
            <name>message</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>foundText</assignToReference>
            <name>resultText</name>
        </outputParameters>
    </actionCalls>
    <actionCalls>
        <name>logCall</name>
        <label>write the audit log</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>AuditLogger</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>Automatic</flowTransactionModel>
        <inputParameters>
            <name>actionName</name>
            <value>
                <stringValue>Candidate Search</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>errorMessage</name>
            <value>
                <elementReference>logError</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>inputsText</name>
            <value>
                <elementReference>logInputs</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>status</name>
            <value>
                <elementReference>logStatus</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>summary</name>
            <value>
                <elementReference>resultText</elementReference>
            </value>
        </inputParameters>
        <nameSegment>AuditLogger</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>showMessage</name>
        <label>show the message</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>resultText</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>searchMessage</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>logStatus</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fMessageStatus</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>logError</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fMessageError</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>logCall</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>showResult</name>
        <label>show the result</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>resultText</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>foundText</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>logStatus</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Success</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>logCall</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>messageCheck</name>
        <label>check the message</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>showResult</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>no message</defaultConnectorLabel>
        <rules>
            <name>hasMessage</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>searchMessage</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>showMessage</targetReference>
            </connector>
            <label>has a message</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>fMessageError</name>
        <dataType>String</dataType>
        <expression>IF({!fMessageStatus} = &quot;Failed&quot;, {!searchMessage}, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>fMessageStatus</name>
        <dataType>String</dataType>
        <expression>IF(CONTAINS({!searchMessage}, &quot;could not be searched&quot;), &quot;Failed&quot;, IF(BEGINS({!searchMessage}, &quot;No processed candidates match&quot;), &quot;Success&quot;, &quot;Needs Input&quot;))</expression>
    </formulas>
    <interviewLabel>Candidate Search {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Candidate Search</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>find_the_candidates</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>logInputs</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Name: {!candidateName} | Skill: {!skill} | Min years: {!minYears} | Location: {!location} | Max results: {!maxResults} | Include cards: {!includeCards}</text>
    </textTemplates>
    <variables>
        <description>Part of the candidate name. Leave empty for any name.</description>
        <name>candidateName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>foundText</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>True to include each Candidate Card text, so questions can be answered from the CV. Limits the result to 8 candidates.</description>
        <name>includeCards</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Part of the city or country, for example Madrid. Leave empty for any location.</description>
        <name>location</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>logError</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>logStatus</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>How many candidates to return. Default 25, maximum 50.</description>
        <name>maxResults</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
    <variables>
        <description>Minimum years of experience, for example 10 means 10 or more. Leave empty for any.</description>
        <name>minYears</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <scale>1</scale>
    </variables>
    <variables>
        <description>The list of matching candidates (name, Id, years, title, location) and a summary line, or a message when nobody matches. Show this to the recruiter.</description>
        <name>resultText</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>searchMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>A skill the candidate must have, for example LWC. Leave empty for any skill.</description>
        <name>skill</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
