    <environments>Default</environments>
    <formulas>
        <name>fConfidence</name>
        <dataType>String</dataType>
        <expression>IF(NOT({!fSane}), &quot;Low&quot;, IF(AND({!fShare} &gt;= 0.7, {!Judge_Requirements.structuredResponse.conflictCountPT} = 0), &quot;High&quot;, IF(OR({!fShare} &lt; 0.4, {!Judge_Requirements.structuredResponse.conflictCountPT} &gt;= 2), &quot;Low&quot;, &quot;Medium&quot;)))</expression>
    </formulas>
    <formulas>
        <name>fFailedBlock</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!failedText}), &quot;&quot;, BR() &amp; BR() &amp; &quot;Not evaluated:&quot; &amp; {!failedText})</expression>
    </formulas>
    <formulas>
        <name>fMessageError</name>
        <dataType>String</dataType>
        <expression>IF({!fMessageStatus} = &quot;Failed&quot;, {!lookupMessage}, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>fMessageStatus</name>
        <dataType>String</dataType>
        <expression>IF(CONTAINS({!lookupMessage}, &quot;could not be read&quot;), &quot;Failed&quot;, &quot;Needs Input&quot;)</expression>
    </formulas>
    <formulas>
        <name>fNoStrong</name>
        <dataType>String</dataType>
        <expression>IF({!topRecommendation} = &quot;Strong&quot;, &quot;&quot;, BR() &amp; &quot;No strong match. Best available: &quot; &amp; {!topName} &amp; &quot;.&quot;)</expression>
    </formulas>
    <formulas>
        <name>fRecommendation</name>
        <dataType>String</dataType>
        <expression>IF(AND({!fScore} &gt;= 75, {!Judge_Requirements.structuredResponse.mustMetPT} = {!Judge_Requirements.structuredResponse.mustTotalPT}), &quot;Strong&quot;, IF({!fScore} &gt;= 55, &quot;Possible&quot;, &quot;Weak&quot;))</expression>
    </formulas>
    <formulas>
        <name>fSane</name>
        <dataType>Boolean</dataType>
        <expression>AND({!Judge_Requirements.structuredResponse.mustMetPT} + {!Judge_Requirements.structuredResponse.mustPartlyPT} &lt;= {!Judge_Requirements.structuredResponse.mustTotalPT}, {!Judge_Requirements.structuredResponse.niceMetPT} + {!Judge_Requirements.structuredResponse.nicePartlyPT} &lt;= {!Judge_Requirements.structuredResponse.niceTotalPT})</expression>
    </formulas>
    <formulas>
        <name>fScore</name>
        <dataType>Number</dataType>
        <expression>ROUND(100 * ({!pMust} + {!pExp} + {!pNice}) / (60 + 25 + IF({!Judge_Requirements.structuredResponse.niceTotalPT} &gt; 0, 15, 0)), 1)</expression>
        <scale>1</scale>
    </formulas>
    <formulas>
        <name>fShare</name>
        <dataType>Number</dataType>
        <expression>IF({!Judge_Requirements.structuredResponse.mustTotalPT} + {!Judge_Requirements.structuredResponse.niceTotalPT} = 0, 0, ({!Judge_Requirements.structuredResponse.mustMetPT} + {!Judge_Requirements.structuredResponse.niceMetPT}) / ({!Judge_Requirements.structuredResponse.mustTotalPT} + {!Judge_Requirements.structuredResponse.niceTotalPT}))</expression>
        <scale>4</scale>
    </formulas>
    <formulas>
        <name>fYears</name>
        <dataType>Number</dataType>
        <expression>IF(OR(ISBLANK({!loopCands.Total_Years_Experience_c__c}), NOT(ISNUMBER({!loopCands.Total_Years_Experience_c__c}))), 0, VALUE({!loopCands.Total_Years_Experience_c__c}))</expression>
        <scale>1</scale>
    </formulas>
    <formulas>
        <name>pExp</name>
        <dataType>Number</dataType>
        <expression>IF(OR(ISBLANK({!theRole.Min_Years_c__c}), {!theRole.Min_Years_c__c} = 0), 25, ROUND(25 * MIN(1, {!fYears} / {!theRole.Min_Years_c__c}), 1))</expression>
        <scale>1</scale>
    </formulas>
    <formulas>
        <name>pMust</name>
        <dataType>Number</dataType>
        <expression>IF({!Judge_Requirements.structuredResponse.mustTotalPT} &gt; 0, ROUND(60 * ({!Judge_Requirements.structuredResponse.mustMetPT} + 0.5*{!Judge_Requirements.structuredResponse.mustPartlyPT}) / {!Judge_Requirements.structuredResponse.mustTotalPT}, 1), 0)</expression>
        <scale>1</scale>
    </formulas>
    <formulas>
        <name>pNice</name>
        <dataType>Number</dataType>
        <expression>IF({!Judge_Requirements.structuredResponse.niceTotalPT} &gt; 0, ROUND(15 * ({!Judge_Requirements.structuredResponse.niceMetPT} + 0.5*{!Judge_Requirements.structuredResponse.nicePartlyPT}) / {!Judge_Requirements.structuredResponse.niceTotalPT}, 1), 0)</expression>
        <scale>1</scale>
    </formulas>
