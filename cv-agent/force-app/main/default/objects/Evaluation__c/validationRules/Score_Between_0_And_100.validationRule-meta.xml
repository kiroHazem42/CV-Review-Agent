<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Score_Between_0_And_100</fullName>
    <active>true</active>
    <description>Score must be between 0 and 100.</description>
    <errorConditionFormula>AND(NOT(ISBLANK(Score__c)), OR(Score__c &lt; 0, Score__c &gt; 100))</errorConditionFormula>
    <errorDisplayField>Score__c</errorDisplayField>
    <errorMessage>Score must be between 0 and 100.</errorMessage>
</ValidationRule>
